# Stream Facts Overlay — copy to .env and fill in. Every option is described
# in docs/CONFIG.md.

# --- StreamerSongList (required) ---
# Your channel name as it appears on streamersonglist.com.
SSL_STREAMER_NAME=yourchannel
SSL_PLATFORM=twitch
# The API requires a token on EVERY request. Create a Streamer Access Token at
# streamersonglist.com -> Settings -> Access and paste it here.
SSL_ACCESS_TOKEN=
# streamer (default) | user (Profile > API Access) | bearer (OAuth2)
SSL_TOKEN_KIND=streamer

# --- Who is performing (shown in prompts and fallback facts) ---
# Defaults to SSL_STREAMER_NAME. INSTRUMENT is optional: "piano", "guitar"...
# STREAMER_DISPLAY_NAME=Jane
# INSTRUMENT=piano

# --- Topic packs: topics/<name>.json supply the fallback facts ---
# One or a comma-separated list: video-game, classical, film, pop, general,
# or your own. Keep "general" for the lines about your own compositions.
TOPIC=video-game,classical,film,pop,general

# --- AI provider: ollama (default) | openai | anthropic ---
AI_PROVIDER=ollama
# Applies to every provider. Keep it low: the model restates a source.
TEMPERATURE=0.2

# Ollama (free, local, private). Install from https://ollama.com then
#   ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# Optional second machine to try if the primary is down.
# OLLAMA_FALLBACK_URL=http://192.168.1.50:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=90000

# OpenAI-compatible hosted endpoint (AI_PROVIDER=openai). Works with any
# free tier that speaks the chat-completions API:
#   Groq        https://api.groq.com/openai/v1                        (default)
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.groq.com/openai/v1
# OPENAI_MODEL=llama-3.1-8b-instant

# Anthropic (AI_PROVIDER=anthropic)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Accuracy ---
# on  = look up a Wikipedia article for the song, write ONLY from it, and drop
#       any claim the article does not support. Slower, accurate.
# off = model writes from memory. Fast, and wrong often enough to matter.
FACT_VERIFICATION=on
GROUNDING_TIMEOUT_MS=5000
# Wikimedia asks for a contact in the user agent: your channel or repo URL.
# WIKIPEDIA_CONTACT=https://twitch.tv/yourchannel

# --- Display ---
FACTS_PER_SONG=5
FACT_INTERVAL_SECONDS=15
FACT_DURATION_SECONDS=8

# --- Server ---
PORT=3000
# Safety net for missed realtime events (ms).
SSL_POLL_INTERVAL_MS=15000

# BubbleFacts settings
#
# Copy this file to .env and fill in the two required lines below.
# Everything else has a working default. docs/CONFIG.md explains every
# setting. Lines starting with # are notes and are ignored.

# ---------------------------------------------------------------------------
# Required: your StreamerSongList account
# ---------------------------------------------------------------------------

# Your channel name on streamersonglist.com.
SSL_STREAMER_NAME=yourchannel

# Create one at streamersonglist.com under Settings > Access. Keep it private.
SSL_ACCESS_TOKEN=

# Take requests through StreamElements' Media Request player instead? Leave
# the two lines above out and use these three. The JWT token is in your
# StreamElements dashboard: Account, then Channels, then Show secrets.
# SONG_SOURCE=streamelements
# SE_CHANNEL=yourchannel
# SE_JWT=

# ---------------------------------------------------------------------------
# Where the AI runs
# ---------------------------------------------------------------------------
# Leave these out to use Ollama on this computer (free; install it from
# ollama.com, then run: ollama pull llama3.2).
# Setting one of the keys below switches to that service automatically.

# Groq (free with a daily limit): make a key at console.groq.com/keys
# OPENAI_API_KEY=

# Anthropic Claude (a fraction of a cent per song): platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# You and your music
# ---------------------------------------------------------------------------

# How to refer to you, if not by your channel name.
# STREAMER_DISPLAY_NAME=Jane

# Your instrument, so captions say "playing ... on piano".
# INSTRUMENT=piano

# Facts to use when a song has no Wikipedia article: files in topics/.
# The defaults are examples (video-game, classical, film, pop, piano,
# general). Copy one to make your own, and list its name here.
TOPIC=video-game,classical,film,pop,general

# ---------------------------------------------------------------------------
# Bubbles
# ---------------------------------------------------------------------------

FACTS_PER_SONG=5
# Seconds between bubbles, and how long each one stays up.
FACT_INTERVAL_SECONDS=15
FACT_DURATION_SECONDS=8
# Where bubbles appear: anywhere, top, bottom, left or right.
BUBBLE_AREA=anywhere
# off hides the Now Playing bubble, for when your own overlay shows the song.
NOW_PLAYING=on

# ---------------------------------------------------------------------------
# Rarely changed. See docs/CONFIG.md before touching these.
# ---------------------------------------------------------------------------

# on = write only from the song's Wikipedia article and drop anything it
# doesn't support. off = let the AI write from memory (fast, often wrong).
FACT_VERIFICATION=on

# Keep low: the AI should rephrase the article, not improvise.
TEMPERATURE=0

# The port on this computer. If you change it, also change SERVER near the
# top of frontend/obs/obs-overlay.js.
PORT=3000

# Ollama details, if yours isn't the default.
# OLLAMA_MODEL=llama3.2
# OLLAMA_BASE_URL=http://localhost:11434

# Other OpenAI-compatible services instead of Groq, for example OpenRouter:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_MODEL=the-model-name-your-service-lists

# Wikipedia asks programs to leave a contact: your channel or project page.
# WIKIPEDIA_CONTACT=https://twitch.tv/yourchannel
